# Microsoft Identity Platform / Microsoft Entra ID Configuration
# Register your application in Microsoft Entra Admin Center (portal.azure.com):
# App Registrations -> New Registration -> Single-page application (SPA)
# Redirect URI: http://localhost:3000 (Development) or https://your-domain.com (Production)

# Application (client) ID
VITE_MICROSOFT_CLIENT_ID=your_client_id_here

# Directory (tenant) ID (Use 'common' for multi-tenant, or your specific University/Organization Tenant ID)
VITE_MICROSOFT_TENANT_ID=common

# Redirect URI (Optional, defaults to window.location.origin)
VITE_MICROSOFT_REDIRECT_URI=http://localhost:3000
